# Pelican Bindup — run on the Wings host as root
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every 5 minutes — update orchestration / reboot
# Config defaults to config.yaml next to the binary.
*/5 * * * * /opt/pelican-bindup/pelican-bindup run > /dev/null 2>&1

# After reboot — re-apply bind mounts (mounts do not survive reboot)
@reboot /opt/pelican-bindup/pelican-bindup sync > /dev/null 2>&1

# Optional weekly self-update (enable in config first)
# 0 4 * * 0 /opt/pelican-bindup/pelican-bindup self-update > /dev/null 2>&1
